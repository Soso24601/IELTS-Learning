# =============================================================================
# IELTS Vocabulary Builder · 服务端环境变量
# 复制本文件为 .env 再按需修改（开发模式可只留空，多数有默认值）。
#   服务器进程只读取工作目录下的 .env（dotenv），不是 .env.local。
# =============================================================================

# ---------- 安全 ----------
# 用于加密「每个用户填写的 API Key」的密钥。生产必须设置（长度不限，建议 32 字节 hex）：
#   生成：openssl rand -hex 32
# 开发模式未设置时会自动在 data/.dev-secret 生成一个并持久化，无需手动配置。
APP_SECRET=""

# 允许任何人注册（公开多用户）。设为 false 则关闭注册入口。
PUBLIC_SIGNUP="true"

# 共享学习材料管理员账号（填写现有账号的用户名，忽略大小写）。
# 该账号登录后会看到「材料管理」，可发布视频链接、Excel/CSV 字幕和英文原文。
# Zeabur 生产环境请在服务的环境变量中设置。
# ADMIN_USERNAME="your-existing-username"

# Cookie 是否只在 HTTPS 下发送。默认：生产(NODE_ENV=production)自动开启；本地 http 测试可设 false。
# COOKIE_SECURE=""

# ---------- 数据存储 ----------
# 数据目录（node:sqlite 的 app.db 与音频文件等都会存在这里）。默认：项目下 ./data
# DATA_DIR="./data"

# 单个账号云端数据大小上限（MB）
# USER_DATA_MAX_MB="25"

# ---------- 服务 ----------
# 监听端口（默认 3000）
# PORT="3000"

# ---------- 速率限制 ----------
# 每个登录用户每分钟的 API 请求上限（默认 120）
# AI_RATE_PER_MIN="120"

# ---------- 原 AI Studio 遗留（已不再作为路由依据，可忽略）----------
# 现在每个用户在「账号与设置 → AI 大模型」里填自己的 Key（默认 DeepSeek）。
# 以下变量保留仅为兼容旧部署，不设置也不影响功能。
# GEMINI_API_KEY=""
# CUSTOM_LLM_API_KEY=""
# CUSTOM_LLM_BASE_URL="https://api.openai.com/v1"
# CUSTOM_LLM_MODEL="gpt-4o-mini"
